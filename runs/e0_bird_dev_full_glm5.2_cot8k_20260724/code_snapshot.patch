+        "duration_seconds": round(total_time, 2),
+        "config": cfg,
+        "metrics": metrics.to_dict(),
+    }
+    with open(run_dir / "run_manifest.json", "w", encoding="utf-8") as f:
+        json.dump(run_manifest, f, indent=2, ensure_ascii=False)
