+    def get_foreign_keys(self, tables: list[str] | None = None) -> list[dict[str, Any]]:
+        """Return foreign-key relationships for the given tables."""
+        with self._connection() as conn:
+            if tables is None:
+                tables = self.list_tables()
+            fks = []
+            for table in tables:
+                try:
